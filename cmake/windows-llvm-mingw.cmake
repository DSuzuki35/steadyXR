set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(VRST_LLVM_MINGW "$ENV{VRST_LLVM_MINGW}" CACHE PATH "LLVM-MinGW toolchain root")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES VRST_LLVM_MINGW)
if(NOT VRST_LLVM_MINGW)
  message(FATAL_ERROR "Set VRST_LLVM_MINGW to the extracted LLVM-MinGW directory")
endif()
set(CMAKE_C_COMPILER "${VRST_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${VRST_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${VRST_LLVM_MINGW}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${VRST_LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-static")
