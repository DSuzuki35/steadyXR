cmake_minimum_required(VERSION 3.24)
unset(ENV{SOURCE_DATE_EPOCH})
string(TIMESTAMP before "%s" UTC)
# Build provenance must use the actual build time even with reproducible-build tooling.
set(ENV{SOURCE_DATE_EPOCH} "1")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT_DIR=${TEST_OUTPUT_DIR}"
  "-DPREVIEW_VERSION=0.13.1" -P "${STAMP_SCRIPT}" COMMAND_ERROR_IS_FATAL ANY)
unset(ENV{SOURCE_DATE_EPOCH})
string(TIMESTAMP after "%s" UTC)
file(READ "${TEST_OUTPUT_DIR}/steadyxr-build.json" metadata)
string(JSON built GET "${metadata}" build_unix_seconds)
string(JSON expires GET "${metadata}" expires_unix_seconds)
string(JSON built_text GET "${metadata}" built_at_utc)
if(built LESS before OR built GREATER after)
  message(FATAL_ERROR "Generated timestamp is not the actual build UTC time: ${built}")
endif()
if(NOT expires EQUAL 0)
  message(FATAL_ERROR "A permanent build must use the zero no-expiry timestamp sentinel")
endif()
string(JSON expiry_enabled_type TYPE "${metadata}" expires)
string(JSON expiry_enabled GET "${metadata}" expires)
string(JSON preview_days GET "${metadata}" preview_days)
string(JSON expiry_date_type TYPE "${metadata}" expires_at_utc)
string(JSON version GET "${metadata}" version)
if(NOT expiry_enabled_type STREQUAL "BOOLEAN" OR expiry_enabled OR NOT preview_days EQUAL 0 OR
   NOT expiry_date_type STREQUAL "NULL")
  message(FATAL_ERROR "Metadata must explicitly describe a permanent build without an expiry date")
endif()
if(NOT version STREQUAL "0.13.1")
  message(FATAL_ERROR "Metadata must preserve the requested build version")
endif()
set(ENV{SOURCE_DATE_EPOCH} "${built}")
string(TIMESTAMP expected_built "%Y-%m-%dT%H:%M:%SZ" UTC)
if(NOT built_text STREQUAL expected_built)
  message(FATAL_ERROR "Metadata UTC build date does not represent the recorded timestamp")
endif()
file(READ "${TEST_OUTPUT_DIR}/generated/steadyxr_build_stamp.hpp" first_header)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT_DIR=${TEST_OUTPUT_DIR}"
  "-DPREVIEW_VERSION=0.13.1" -P "${STAMP_SCRIPT}" COMMAND_ERROR_IS_FATAL ANY)
file(READ "${TEST_OUTPUT_DIR}/steadyxr-build.json" next_metadata)
string(JSON next_build GET "${next_metadata}" build_unix_seconds)
file(READ "${TEST_OUTPUT_DIR}/generated/steadyxr_build_stamp.hpp" next_header)
if(NOT next_build GREATER built OR first_header STREQUAL next_header)
  message(FATAL_ERROR "An existing build directory must receive a fresh timestamp/header")
endif()
message(STATUS "PASS: actual UTC build stamp, explicit no-expiry metadata, repeated generation")
