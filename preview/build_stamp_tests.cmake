cmake_minimum_required(VERSION 3.24)
unset(ENV{SOURCE_DATE_EPOCH})
string(TIMESTAMP before "%s" UTC)
# Reproducible-build tooling must not make a new preview expire from a historical source date.
set(ENV{SOURCE_DATE_EPOCH} "1")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT_DIR=${TEST_OUTPUT_DIR}"
  "-DPREVIEW_VERSION=0.7.0" -P "${STAMP_SCRIPT}" COMMAND_ERROR_IS_FATAL ANY)
unset(ENV{SOURCE_DATE_EPOCH})
string(TIMESTAMP after "%s" UTC)
file(READ "${TEST_OUTPUT_DIR}/steadyxr-build.json" metadata)
string(JSON built GET "${metadata}" build_unix_seconds)
string(JSON expires GET "${metadata}" expires_unix_seconds)
string(JSON built_text GET "${metadata}" built_at_utc)
string(JSON expires_text GET "${metadata}" expires_at_utc)
if(built LESS before OR built GREATER after)
  message(FATAL_ERROR "Generated timestamp is not the actual build UTC time: ${built}")
endif()
math(EXPR duration "${expires} - ${built}")
if(NOT duration EQUAL 2592000)
  message(FATAL_ERROR "Preview deadline must be exactly 2592000 seconds after the build")
endif()
set(ENV{SOURCE_DATE_EPOCH} "${built}")
string(TIMESTAMP expected_built "%Y-%m-%dT%H:%M:%SZ" UTC)
set(ENV{SOURCE_DATE_EPOCH} "${expires}")
string(TIMESTAMP expected_expires "%Y-%m-%dT%H:%M:%SZ" UTC)
if(NOT built_text STREQUAL expected_built OR NOT expires_text STREQUAL expected_expires)
  message(FATAL_ERROR "Metadata UTC dates do not represent the recorded timestamps")
endif()
file(READ "${TEST_OUTPUT_DIR}/generated/steadyxr_build_stamp.hpp" first_header)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT_DIR=${TEST_OUTPUT_DIR}"
  "-DPREVIEW_VERSION=0.7.0" -P "${STAMP_SCRIPT}" COMMAND_ERROR_IS_FATAL ANY)
file(READ "${TEST_OUTPUT_DIR}/steadyxr-build.json" next_metadata)
string(JSON next_build GET "${next_metadata}" build_unix_seconds)
file(READ "${TEST_OUTPUT_DIR}/generated/steadyxr_build_stamp.hpp" next_header)
if(NOT next_build GREATER built OR first_header STREQUAL next_header)
  message(FATAL_ERROR "An existing build directory must receive a fresh timestamp/header")
endif()
message(STATUS "PASS: actual UTC build stamp, exact duration, UTC metadata, repeated generation")
