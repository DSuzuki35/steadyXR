uniform float4x4 ViewProj;
uniform texture2d image;
uniform float4 row_x;
uniform float4 row_y;
uniform float4 trim_uv;
uniform float4 footprint;
uniform float4 pose_input;
uniform float4 pose_output;
uniform float4 pose_correction;
uniform float4 pose_uv;

sampler_state linear_clamp {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v) {
    v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    return v;
}

float4 PSWarp(VertData v) : TARGET {
    float3 uv = float3(v.uv, 1.0);
    return image.Sample(linear_clamp, float2(dot(row_x.xyz, uv), dot(row_y.xyz, uv)));
}

// Both analysis and final rendering map through the pose warp saved with the
// raw frame. Final residual coordinates live in that safe, pose-corrected view.
float2 pose_map(float2 uv) {
    float3 ray = float3(lerp(pose_output.x, pose_output.y, uv.x),
                        lerp(pose_output.z, pose_output.w, uv.y), -1.0);
    ray += 2.0 * cross(pose_correction.xyz,
                      cross(pose_correction.xyz, ray) + pose_correction.w * ray);
    float2 tangent = ray.xy / -ray.z;
    float2 local_uv = float2((tangent.x - pose_input.x) / (pose_input.y - pose_input.x),
                            (pose_input.z - tangent.y) / (pose_input.z - pose_input.w));
    return float2(lerp(pose_uv.x, pose_uv.y, local_uv.x),
                  lerp(pose_uv.z, pose_uv.w, local_uv.y));
}

float4 PSHybrid(VertData v) : TARGET {
    float3 uv = float3(v.uv, 1.0);
    return image.Sample(linear_clamp, pose_map(float2(dot(row_x.xyz, uv), dot(row_y.xyz, uv))));
}

float3 analysis_sample(float2 p, bool hybrid) {
    return image.Sample(linear_clamp, hybrid ? pose_map(p) : p).rgb;
}

float4 analyze(float2 p, float2 d, bool hybrid) {
    // Four by four bilinear box samples across the footprint of one analysis
    // pixel suppress aliasing when a 4K input is reduced to 480 by 270.
    float3 c = analysis_sample(p + d * float2(-0.375, -0.375), hybrid);
    c += analysis_sample(p + d * float2(-0.125, -0.375), hybrid);
    c += analysis_sample(p + d * float2( 0.125, -0.375), hybrid);
    c += analysis_sample(p + d * float2( 0.375, -0.375), hybrid);
    c += analysis_sample(p + d * float2(-0.375, -0.125), hybrid);
    c += analysis_sample(p + d * float2(-0.125, -0.125), hybrid);
    c += analysis_sample(p + d * float2( 0.125, -0.125), hybrid);
    c += analysis_sample(p + d * float2( 0.375, -0.125), hybrid);
    c += analysis_sample(p + d * float2(-0.375,  0.125), hybrid);
    c += analysis_sample(p + d * float2(-0.125,  0.125), hybrid);
    c += analysis_sample(p + d * float2( 0.125,  0.125), hybrid);
    c += analysis_sample(p + d * float2( 0.375,  0.125), hybrid);
    c += analysis_sample(p + d * float2(-0.375,  0.375), hybrid);
    c += analysis_sample(p + d * float2(-0.125,  0.375), hybrid);
    c += analysis_sample(p + d * float2( 0.125,  0.375), hybrid);
    c += analysis_sample(p + d * float2( 0.375,  0.375), hybrid);
    float gray = dot(c / 16.0, float3(0.2126, 0.7152, 0.0722));
    return float4(gray, gray, gray, 1.0);
}

float4 PSAnalyze(VertData v) : TARGET {
    return analyze(trim_uv.xy + v.uv * trim_uv.zw, footprint.xy, false);
}
float4 PSAnalyzeHybrid(VertData v) : TARGET {
    return analyze(v.uv, footprint.xy, true);
}

technique DrawHybrid {
    pass { vertex_shader = VSDefault(v); pixel_shader = PSHybrid(v); }
}
technique AnalyzeHybrid {
    pass { vertex_shader = VSDefault(v); pixel_shader = PSAnalyzeHybrid(v); }
}
technique Draw {
    pass { vertex_shader = VSDefault(v); pixel_shader = PSWarp(v); }
}
technique Analyze {
    pass { vertex_shader = VSDefault(v); pixel_shader = PSAnalyze(v); }
}
