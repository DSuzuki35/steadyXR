uniform float4x4 ViewProj;
uniform texture2d image;
uniform float4 input_projection;  // signed left, right, up, down tangents
uniform float4 output_projection;
uniform float4 correction;        // quaternion x, y, z, w
uniform float4 input_uv;          // original texture's left, right, top, bottom

sampler_state source_sampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSStabilize(VertData v_in)
{
    VertData result;
    result.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    result.uv = v_in.uv;
    return result;
}

float4 PSStabilize(VertData v_in) : TARGET
{
    // Eye space is right handed: X right, Y up, -Z forward. This inverse
    // reprojection rotates each output ray into the captured source eye.
    float3 ray = float3(lerp(output_projection.x, output_projection.y, v_in.uv.x),
                        lerp(output_projection.z, output_projection.w, v_in.uv.y), -1.0);
    ray = ray + 2.0 * cross(correction.xyz, cross(correction.xyz, ray) + correction.w * ray);
    if (ray.z >= -0.000001)
        return float4(0.0, 0.0, 0.0, 0.0);
    float2 tangent = ray.xy / -ray.z;
    float2 local_uv = float2((tangent.x - input_projection.x) / (input_projection.y - input_projection.x),
                             (input_projection.z - tangent.y) / (input_projection.z - input_projection.w));
    if (local_uv.x < 0.0 || local_uv.x > 1.0 || local_uv.y < 0.0 || local_uv.y > 1.0)
        return float4(0.0, 0.0, 0.0, 0.0);
    float2 source_uv = float2(lerp(input_uv.x, input_uv.y, local_uv.x),
                              lerp(input_uv.z, input_uv.w, local_uv.y));
    return image.Sample(source_sampler, source_uv);
}

technique Draw
{
    pass
    {
        vertex_shader = VSStabilize(v_in);
        pixel_shader = PSStabilize(v_in);
    }
}
